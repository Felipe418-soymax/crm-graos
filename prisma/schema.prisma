generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  role                String   @default("seller") // admin | seller
  loadingOrderLayout  String?  // JSON: custom field sections for loading order page (null = default layout)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  activities      ActivityLog[]
  companySettings CompanySettings?
  clients         Client[]
  leads           Lead[]
  deals           Deal[]
  shipments       Shipment[]
  loadingOrders   LoadingOrder[]
}

model Client {
  id              String   @id @default(cuid())
  type            String   // producer | buyer
  name            String
  farmOrCompany   String?
  city            String
  state           String
  phone           String
  email           String?
  mainProducts    String   // JSON: ["soja","milho"]
  estimatedVolume Float?
  notes           String?
  status          String   @default("active") // active | inactive
  sellerId        String   @default("")
  seller          User     @relation(fields: [sellerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deals         Deal[]
  leads         Lead[]         @relation("ConvertedLead")
  loadingOrders LoadingOrder[]
}

model Lead {
  id                String   @id @default(cuid())
  name              String
  phone             String
  email             String?
  city              String
  state             String
  source            String   // indication | instagram | call | other
  stage             String   @default("new") // new | contacted | qualified | unqualified
  interestProducts  String
  notes             String?
  convertedClientId String?
  convertedClient   Client?  @relation("ConvertedLead", fields: [convertedClientId], references: [id])
  sellerId          String   @default("")
  seller            User     @relation(fields: [sellerId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Deal {
  id                String    @id @default(cuid())
  clientId          String
  client            Client    @relation(fields: [clientId], references: [id])
  product           String    // soja | milho | outros
  side              String    // buy | sell
  volume            Float
  unit              String    // sc | kg | t
  unitPrice         Float
  totalValue        Float
  commissionPct     Float     @default(0.8)
  commissionValue   Float
  status            String    @default("new") // new | proposal | negotiating | closed | lost
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  sellerId          String    @default("")
  seller            User      @relation(fields: [sellerId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shipments     Shipment[]
  loadingOrders LoadingOrder[]
}

model PriceHistory {
  id          String   @id @default(cuid())
  product     String
  produtoId   String?
  produto     Produto? @relation(fields: [produtoId], references: [id])
  regionLabel String
  date        DateTime
  price       Float
  unit        String   // sc | kg | t | L | mL
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String   // client | lead | deal
  entityId   String
  action     String   // created | updated | status_changed
  details    String?  // JSON
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Produto {
  id             String         @id @default(cuid())
  name           String         @unique
  unit           String         @default("sc")
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  priceHistories PriceHistory[]
}

model CompanySettings {
  id                String   @id @default(cuid())
  // Dados da Empresa
  companyName       String?  // Razão Social
  tradeName         String?  // Nome Fantasia
  cnpjCpf           String?  // CNPJ / CPF
  stateRegistration String?  // Inscrição Estadual
  phone             String?  // Telefone
  email             String?  // Email
  // Endereço
  street            String?  // Rua
  number            String?  // Número
  district          String?  // Bairro
  city              String?  // Cidade
  state             String?  // Estado
  zipCode           String?  // CEP
  country           String?  @default("Brasil")
  // Branding
  logoUrl           String?  // Logo da Empresa (original comprimida)
  logoThumbnailUrl  String?  // Variante: thumbnail 64x64
  logoHeaderUrl     String?  // Variante: header 180x60
  logoFaviconUrl    String?  // Variante: favicon 32x32 PNG
  shortName         String?  // Nome curto (PWA shortcut)
  // Legacy
  region            String?
  // Relations
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Shipment {
  id             String         @id @default(cuid())
  dealId         String
  deal           Deal           @relation(fields: [dealId], references: [id])
  status         String         @default("confirmed") // pending | confirmed
  truckPlate     String
  cargoWeightKg  Float
  bagsQuantity   Float          // Calculated: cargoWeightKg / 60
  loadedProduct  String
  loadingDate    DateTime
  cargoValue     Float
  driverName     String
  driverPhone    String
  invoicePdfPath String?
  sellerId       String
  seller         User           @relation(fields: [sellerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  loadingOrders  LoadingOrder[]
}

model LoadingOrder {
  id          String   @id @default(cuid())
  orderNumber Int      @unique @default(autoincrement())
  status      String   @default("draft") // draft | issued | loading | completed | cancelled

  // Relations
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id])
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])
  sellerId   String
  seller     User      @relation(fields: [sellerId], references: [id])

  // Snapshot: Cliente
  clientName    String?
  clientAddress String?
  clientCnpjCpf String?
  clientCity    String?
  clientState   String?
  clientCep     String?
  clientIe      String?
  clientEmail   String?
  clientPhone   String?

  // Snapshot: Embarque / Destino
  loadingAddress   String?
  deliveryLocation String?
  deliveryCityUf   String?

  // Snapshot: Motorista
  driverName    String?
  driverCpf     String?
  driverPhone   String?
  driverAddress String?
  driverCep     String?
  driverEmail   String?

  // Snapshot: Transportadora
  carrierName  String?
  carrierCnpj  String?
  carrierPhone String?
  truckPlate   String?
  vehicle      String?
  scaleWeight  Float?

  // Snapshot: Destinatário
  recipientName      String?
  recipientCnpjCpf   String?
  recipientPhone     String?
  recipientAddress   String?
  recipientCep       String?
  recipientIe        String?

  // Produto
  product     String?
  quantity    Float?
  unit        String?
  description String?
  tare        Float?
  grossWeight Float?

  // Campos extras (perfis personalizados)
  origin              String?  // Origem
  warehouse           String?  // Armazém / Fazenda
  authorizedCompany   String?  // Empresa autorizada
  company             String?  // Empresa
  ownerName           String?  // Proprietário
  vehicleCity         String?  // Cidade do veículo
  vehicleState        String?  // UF do veículo
  antt                String?  // ANTT
  weightKg            Float?   // Peso (Kgs)
  cargoType           String?  // Tipo da carga
  harvest             String?  // Safra
  commodity           String?  // Mercadoria
  producerName        String?  // Produtor
  responsibleName     String?  // Responsável

  // Meta
  observations String?
  issuedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([dealId])
  @@index([clientId])
  @@index([sellerId])
  @@index([status])
  @@index([issuedAt])
}
